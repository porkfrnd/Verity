# Verity env — copy to .env and fill in. Never commit real keys.
PORT=3000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Search works with zero keys (DuckDuckGo HTML provider by default).
SEARCH_PROVIDER=
SEARXNG_URL=
WIKIPEDIA_LANG=
FACTCHECK_API_KEY=
DDG_REQUEST_GAP_MS=
SOURCE_FETCH_TIMEOUT_MS=
# Do NOT set NODE_ENV here: build/start scripts manage it themselves, and
# building with NODE_ENV=development would ship a development React bundle.
